# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
# MongoDB Atlas connection string, e.g.:
# mongodb+srv://<user>:<password>@cluster0.mongodb.net/visiondeck
MONGO_URI=mongodb://localhost:27017/visiondeck

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Cloudinary (image & resume uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (contact form notification emails via Nodemailer) ---
# If left blank, the server logs contact messages to the console instead of emailing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_INBOX=

# --- Seed script ---
SEED_ADMIN_EMAIL=admin@visiondeck.dev
SEED_ADMIN_PASSWORD=ChangeThisPassword123
SEED_ADMIN_NAME=VisionDeck Admin
